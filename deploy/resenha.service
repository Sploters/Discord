[Unit]
Description=Resenha (chat/voz auto-hospedado)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=resenha
WorkingDirectory=/opt/resenha
Environment=PORT=3000
Environment=HTTPS_PORT=3443
Environment=DATA_DIR=/var/lib/resenha
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
StateDirectory=resenha

[Install]
WantedBy=multi-user.target
