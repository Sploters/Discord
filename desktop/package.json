{
  "name": "localcord-desktop",
  "version": "1.0.23",
  "description": "LocalCord Desktop — cliente do seu servidor LocalCord",
  "main": "main.js",
  "author": "LocalCord",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "npm run native && node make-icon.mjs && electron-builder --win",
    "native": "node build-native.mjs"
  },
  "build": {
    "appId": "br.local.localcord",
    "productName": "LocalCord",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "connect.html",
      "splash.html",
      "build/icon.png",
      "build/tray.png",
      "remote.js",
      "build/icon.ico",
      "native.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "LocalCord-Setup-${version}.${ext}"
    },
    "portable": {
      "splashImage": "build/splash.bmp",
      "artifactName": "LocalCord-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "native/lc-input.exe",
        "to": "lc-input.exe"
      },
      {
        "from": "native/lc-stream.exe",
        "to": "lc-stream.exe"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
